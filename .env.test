# Safe test-only settings. These values are intentionally non-secret.

# App
APP_URL_SCHEMA=http
APP_DEBUG=true
APP_SECRET_KEY=TEST_SECRET_KEY
APP_DOMAIN=localhost
APP_USE_CACHE=false
APP_CONTACT_REQUESTS_ENABLED=false

# Auth API
AUTH_VERIFY_URL=http://auth.example.test/api/auth/verify
AUTH_TIMEOUT_SECONDS=2
AUTH_CACHE_TTL_SECONDS=15
AUTH_MAX_CACHE_ENTRIES=10000

# I18n
I18N_DEFAULT_LANGUAGE=ru

# Competency Matrix
COMPETENCY_MATRIX_QUESTION_SUGGESTION_ANONYMOUS_DAILY_LIMIT=10
AGENT_ACCESS_ISSUING_CERTIFICATE_FILE=/run/secrets/agent_issuing_certificate
AGENT_ACCESS_ISSUING_PRIVATE_KEY_FILE=/run/secrets/agent_issuing_private_key
AGENT_ACCESS_CERTIFICATE_CHAIN_FILE=/run/secrets/agent_certificate_chain

# TaskIQ
TASKIQ_AGENT_AUDIT_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_CACHE_WARM_INTERVAL_SECONDS=3600
TASKIQ_FILE_ORPHAN_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_RESULT_EXPIRE_SECONDS=3600

# Files
FILES_ORPHAN_RETENTION_SECONDS=604800

# Cache warm
CACHE_WARM_ARTICLES_PAGE_SIZE=10

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=55432
DB_NAME=competency_trainer_database_test
DB_POOL_PRE_PING=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_EXPIRE_ON_COMMIT=false
DB_LOG_QUERY_METRICS=false
DB_SLOW_QUERY_LOG_THRESHOLD_MS=250
DB_SLOW_QUERY_LOG_STATEMENT_MAX_LENGTH=1000

# Minio
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_REGION=us-east-1
MINIO_SECRET_KEY=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_CORS_MAX_AGE_SECONDS=300

# Sentry
SENTRY_USE=false
SENTRY_DSN=

# Cache
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Query-plan reports (relative to the project root/)
PERFORMANCE_REPORT_DIR=performance/reports
